{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ATF-AI RWA Privileged Action Record",
  "type": "object",
  "required": ["agent_id", "action_id", "timestamp", "action", "requester", "governance", "provenance", "trace", "execution"],
  "properties": {
    "agent_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "action": {
      "type": "object",
      "required": ["kind", "asset_id", "target"],
      "properties": {
        "kind": {"type": "string", "enum": ["mint", "burn", "freeze", "unfreeze", "pause", "unpause", "upgrade_contract", "change_oracle", "change_compliance_rule", "change_signer", "redemption", "settlement", "emergency_action"]},
        "asset_id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"}
      }
    },
    "requester": {
      "type": "object",
      "required": ["id", "roles"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "governance": {
      "type": "object",
      "required": ["policy_id", "decision", "validator", "required_quorum", "approvals"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "enum": ["approved", "rejected", "escalated"]},
        "validator": {"type": "string", "minLength": 1},
        "required_quorum": {"type": "integer", "minimum": 1},
        "required_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["approver_id", "role", "approved_at"],
            "properties": {
              "approver_id": {"type": "string"},
              "role": {"type": "string"},
              "approved_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        "timelock_until": {"type": "string", "format": "date-time"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["hash"],
      "properties": {"hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}
    },
    "trace": {
      "type": "object",
      "required": ["id", "span_id"],
      "properties": {"id": {"type": "string"}, "span_id": {"type": "string"}}
    },
    "execution": {
      "type": "object",
      "required": ["method", "payload_hash"],
      "properties": {
        "method": {"type": "string", "enum": ["multisig", "mpc", "hsm", "hardware-wallet", "custodian", "other"]},
        "payload_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "tx_ref": {"type": "string"},
        "settlement_ref": {"type": "string"}
      }
    }
  }
}
